+    private boolean isIncidentOrigin() {
+        Uri page = Uri.parse(webView.getUrl() == null ? "" : webView.getUrl());
+        return "https".equals(page.getScheme()) && "app.tugeocercas.com".equals(page.getHost())
+                && (page.getPort() == -1 || page.getPort() == 443);
+    }
