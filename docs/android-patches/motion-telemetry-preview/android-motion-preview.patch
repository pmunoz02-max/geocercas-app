+// Location bearing is direction of travel, not device orientation.
+internal fun writeLocationMotionTelemetry(payload: JSONObject, location: Location) {
+    val speed = if (location.hasSpeed()) location.speed.takeIf { it.isFinite() && it >= 0f } else null
+    val heading = if (location.hasBearing()) location.bearing.takeIf { it.isFinite() && it >= 0f && it < 360f } else null
+    payload.put("speed", speed?.toDouble() ?: JSONObject.NULL)
+    payload.put("heading", heading?.toDouble() ?: JSONObject.NULL)
+}
+
+// Allow a missed interval plus watchdog scheduling jitter before recovery.
+internal fun locationRecoveryTimeoutMs(intervalMs: Long): Long =
+    intervalMs.coerceAtLeast(60_000L) * 2L + 30_000L
+
