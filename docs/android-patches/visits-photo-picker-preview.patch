     private class AppChromeClient extends WebChromeClient {
+        @Override
+        public boolean onShowFileChooser(WebView view, ValueCallback<Uri[]> callback, FileChooserParams params) {
+            Uri page = Uri.parse(view.getUrl() == null ? "" : view.getUrl());
+            if (!"https".equals(page.getScheme()) || !"preview.tugeocercas.com".equals(page.getHost())) {
+                callback.onReceiveValue(null);
+                return true;
+            }
+            if (visitPhotoCallback != null) visitPhotoCallback.onReceiveValue(null);
+            visitPhotoCallback = callback;
+            Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+            pick.addCategory(Intent.CATEGORY_OPENABLE);
+            pick.setType("image/*");
+            pick.putExtra(Intent.EXTRA_MIME_TYPES, new String[]{"image/jpeg", "image/png"});
+            try { startActivityForResult(pick, VISIT_PHOTO_REQUEST); }
+            catch (android.content.ActivityNotFoundException error) {
+                visitPhotoCallback = null;
+                callback.onReceiveValue(null);
+            }
+            return true;
+        }
