+    private boolean isVisitsOrigin() {
+        Uri page = Uri.parse(webView.getUrl() == null ? "" : webView.getUrl());
+        return "https".equals(page.getScheme()) && "preview.tugeocercas.com".equals(page.getHost());
+    }
